# =============================================
# HEALTHFLOW ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in real values.
# Never commit the actual .env file.
# =============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local:  mongodb://localhost:27017/healthflow
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/healthflow
MONGODB_URI=

# JWT
JWT_SECRET=use_a_long_random_string_at_least_32_characters
JWT_EXPIRES_IN=7d

# AI (Groq)
GROQ_API_KEY=

# CORS - your deployed frontend URL
FRONTEND_URL=

# Admin seed account
ADMIN_EMAIL=
ADMIN_PASSWORD=
